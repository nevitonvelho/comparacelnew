{
  "manifest_version": 3,
  "name": "Comparacel — Importador de produtos",
  "version": "1.5.3",
  "description": "Importa produtos e ofertas da Amazon, Mercado Livre e Shopee para o Comparacel.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "optional_host_permissions": [
    "https://*/*"
  ],
  "host_permissions": [
    "http://localhost:3000/*",
    "https://comparacel.com.br/*",
    "https://www.comparacel.com.br/*",
    "https://amazon.com.br/*",
    "https://www.amazon.com.br/*",
    "https://mercadolivre.com.br/*",
    "https://www.mercadolivre.com.br/*",
    "https://lista.mercadolivre.com.br/*",
    "https://produto.mercadolivre.com.br/*",
    "https://shopee.com.br/*",
    "https://www.shopee.com.br/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Coletar produto para o Comparacel"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://amazon.com.br/*",
        "https://www.amazon.com.br/*",
        "https://mercadolivre.com.br/*",
        "https://www.mercadolivre.com.br/*",
        "https://lista.mercadolivre.com.br/*",
        "https://produto.mercadolivre.com.br/*"
      ],
      "js": [
        "listing.js"
      ],
      "css": [
        "listing.css"
      ],
      "run_at": "document_idle"
    }
  ]
}
