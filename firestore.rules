rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function owner(uid) { return request.auth != null && request.auth.uid == uid; }
    function activeProduct(id) {
      return id is string && id.size() > 0 && id.size() <= 400
        && exists(/databases/$(database)/documents/products/$(id))
        && get(/databases/$(database)/documents/products/$(id)).data.isActive == true;
    }
    function validProduct(data, id) {
      return data.keys().hasAll(['productId', 'createdAt'])
        && data.keys().hasOnly(['productId', 'createdAt'])
        && data.productId == id && activeProduct(data.productId)
        && data.createdAt is timestamp && data.createdAt == request.time;
    }
    function validComparison(data, id) {
      return data.keys().hasAll(['productIds', 'createdAt'])
        && data.keys().hasOnly(['productIds', 'createdAt'])
        && data.productIds is list && data.productIds.size() == 2
        && activeProduct(data.productIds[0]) && activeProduct(data.productIds[1])
        && data.productIds[0] != data.productIds[1]
        && id == data.productIds[0] + '-vs-' + data.productIds[1]
        && get(/databases/$(database)/documents/products/$(data.productIds[0])).data.categorySlug
          == get(/databases/$(database)/documents/products/$(data.productIds[1])).data.categorySlug
        && data.createdAt is timestamp && data.createdAt == request.time;
    }
    match /products/{productId} {
      allow read: if resource.data.isActive == true;
      allow write: if false;
    }
    match /users/{uid}/likedProducts/{id} {
      allow read, delete: if owner(uid);
      allow create, update: if owner(uid) && validProduct(request.resource.data, id);
    }
    match /users/{uid}/{kind}/{id} {
      allow read, delete: if owner(uid) && kind in ['likedComparisons', 'savedComparisons'];
      allow create, update: if owner(uid) && kind in ['likedComparisons', 'savedComparisons']
        && validComparison(request.resource.data, id);
    }
    function validProfile(data) {
      return data.keys().hasAll(['displayName','bio','photoURL','updatedAt'])
        && data.keys().hasOnly(['displayName','bio','photoURL','updatedAt'])
        && data.displayName is string && data.displayName.size() > 0 && data.displayName.size() <= 60
        && data.bio is string && data.bio.size() <= 280
        && (data.photoURL == null || (data.photoURL is string && data.photoURL.size() <= 2000 && data.photoURL.matches('https://lh3[.]googleusercontent[.]com/.*')))
        && data.updatedAt is timestamp && data.updatedAt == request.time;
    }
    function validPublication(data) {
      return data.keys().hasAll(['authorUid','authorName','authorPhoto','title','opinion','productIds','category','winner','status','createdAt'])
        && data.keys().hasOnly(['authorUid','authorName','authorPhoto','title','opinion','productIds','category','winner','status','createdAt'])
        && request.auth != null && data.authorUid == request.auth.uid
        && exists(/databases/$(database)/documents/profiles/$(request.auth.uid))
        && data.authorName == get(/databases/$(database)/documents/profiles/$(request.auth.uid)).data.displayName
        && data.authorPhoto == get(/databases/$(database)/documents/profiles/$(request.auth.uid)).data.photoURL
        && data.title is string && data.title.size() >= 5 && data.title.size() <= 100
        && data.opinion is string && data.opinion.size() >= 20 && data.opinion.size() <= 3000
        && data.productIds is list && data.productIds.size() == 2
        && activeProduct(data.productIds[0]) && activeProduct(data.productIds[1])
        && data.productIds[0] != data.productIds[1]
        && data.category == get(/databases/$(database)/documents/products/$(data.productIds[0])).data.categorySlug
        && data.category == get(/databases/$(database)/documents/products/$(data.productIds[1])).data.categorySlug
        && (data.winner in data.productIds || data.winner in ['tie','undecided'])
        && data.status == 'published'
        && data.createdAt is timestamp && data.createdAt == request.time;
    }
    match /profiles/{uid} {
      allow read: if true;
      allow create, update: if owner(uid) && validProfile(request.resource.data);
      allow delete: if false;
    }
    match /socialPosts/{id} {
      allow read: if resource.data.status == 'published';
      allow create: if validPublication(request.resource.data);
      allow update: if false;
      allow delete: if owner(resource.data.authorUid);
    }
    match /reactionStats/{id} {
      allow read: if true;
      allow write: if false;
    }
    match /users/{uid}/reactions/{id} {
      allow read: if owner(uid);
      allow write: if false;
    }
    match /{document=**} { allow read, write: if false; }
  }
}
